---
import Icon from "./Icon.astro";
import type { FaqItem } from "../data/faqs";

/**
 * A list of questions that open to their answers.
 *
 * Built on `<details>`, so it needs no JavaScript and is keyboard operable
 * for free. The same items go to `BaseLayout` as FAQPage structured data via
 * `faqSchema`, so a search engine reads the answers whether or not it renders
 * the page.
 */
interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<dl class:list={["divide-y divide-outline-variant/30 border-y border-outline-variant/30", className]}>
  {
    items.map((item) => (
      <details class="group/faq">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left [&::-webkit-details-marker]:hidden">
          <dt class="font-headline-sm text-lg text-primary md:text-xl">{item.question}</dt>
          <Icon
            name="expand_more"
            class="mt-1 shrink-0 text-2xl text-secondary transition-transform duration-300 group-open/faq:rotate-180"
          />
        </summary>
        <dd class="font-body-md text-body-lg max-w-3xl pb-6 leading-relaxed text-on-surface-variant">
          {item.answer}
        </dd>
      </details>
    ))
  }
</dl>
