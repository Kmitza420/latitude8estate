---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  label: string;
  /** Material Symbols name, placed after the label. */
  icon?: string;
  /**
   * gold    — filled gold pill on dark artwork or a green panel
   * outline — bordered gold pill, for a secondary action beside a gold one
   */
  variant?: "gold" | "outline";
  /** `sm` is the compact pill used inside cards. */
  size?: "md" | "sm";
  /** Stretch to the container, as the in-card variant does. */
  block?: boolean;
  class?: string;
}

const {
  href,
  label,
  icon,
  variant = "gold",
  size = "md",
  block = false,
  class: className = "",
} = Astro.props;
---

{/* The gold pill call to action, shared by the hero and the in-card prompts. */}
<a
  href={href}
  class:list={[
    "font-label-md inline-flex items-center justify-center gap-3 rounded-full transition-all",
    size === "md" ? "text-label-md px-9 py-4" : "gap-2 px-5 py-4 text-xs tracking-wider uppercase",
    variant === "gold" &&
      "bg-secondary-fixed text-primary shadow-lg hover:bg-white hover:shadow-2xl",
    variant === "outline" &&
      "border border-secondary-fixed text-secondary-fixed hover:bg-secondary-fixed hover:text-primary",
    block && "w-full",
    className,
  ]}
>
  <span>{label}</span>
  {icon && <Icon name={icon} class={size === "md" ? "text-lg" : "text-sm"} />}
</a>
