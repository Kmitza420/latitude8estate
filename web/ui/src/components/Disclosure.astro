---
import Icon from "./Icon.astro";

interface Props {
  /** Label while collapsed. */
  label?: string;
  /** Label while expanded. */
  openLabel?: string;
  class?: string;
}

const { label = "More info", openLabel = "Less info", class: className = "" } =
  Astro.props;
---

{/*
  A show/hide toggle built on `<details>`, so it ships no JavaScript and is
  keyboard and screen-reader operable for free. The mockups drove this kind of
  panel from a click handler that toggled `hidden` and rewrote the button text;
  here the open state is read straight off the element with `group-open/disclosure:`,
  which covers both the chevron and the label swap.
*/}
<details class:list={["group/disclosure", className]}>
  <summary
    class="font-label-md flex cursor-pointer list-none items-center gap-2 text-xs tracking-wider text-secondary uppercase transition-colors hover:text-primary [&::-webkit-details-marker]:hidden"
  >
    <span class="group-open/disclosure:hidden">{label}</span>
    <span class="hidden group-open/disclosure:inline">{openLabel}</span>
    <Icon
      name="expand_more"
      class="text-sm transition-transform duration-300 group-open/disclosure:rotate-180"
    />
  </summary>

  <div class="mt-4">
    <slot />
  </div>
</details>
