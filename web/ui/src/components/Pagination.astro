---
import Icon from "./Icon.astro";

interface Props {
  currentPage: number;
  totalPages: number;
  /** Page 1 lives at this path; later pages at `${base}/page/N`. */
  base: string;
}

const { currentPage, totalPages, base } = Astro.props;

const hrefFor = (page: number) => (page === 1 ? base : `${base}/page/${page}`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav
      class="mt-section-gap flex items-center justify-center gap-6"
      aria-label="Pagination"
    >
      {pages.map((page) => (
        <a
          href={hrefFor(page)}
          aria-current={page === currentPage ? "page" : undefined}
          class:list={[
            "font-label-md text-label-md flex h-10 w-10 items-center justify-center rounded-full transition-colors",
            page === currentPage
              ? "bg-primary text-on-primary"
              : "text-primary hover:bg-surface-variant",
          ]}
        >
          {page}
        </a>
      ))}

      {currentPage < totalPages && (
        <a
          href={hrefFor(currentPage + 1)}
          class="font-label-md text-label-md flex items-center justify-center rounded-full px-4 py-2 tracking-wider text-primary uppercase transition-colors hover:bg-surface-variant"
        >
          Next
          <Icon name="arrow_forward" class="ml-1 text-sm" />
        </a>
      )}
    </nav>
  )
}
