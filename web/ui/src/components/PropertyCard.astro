---
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /**
   * card - surfaced card with padding, used in the home page rail
   * tile - bare image over text, used in the portfolio grid
   */
  variant?: "card" | "tile";
  class?: string;
}

const { project, variant = "card", class: className = "" } = Astro.props;
const href = `/projects/${project.slug}`;

// Only the stats this listing actually has. A record with no floor area shows
// beds and baths rather than an em dash where the third figure would be.
const stats = [
  project.beds ? { icon: "bed", label: `${project.beds} Beds` } : null,
  project.baths ? { icon: "bathtub", label: `${project.baths} Baths` } : null,
  project.area ? { icon: "square_foot", label: project.area } : null,
].filter((stat): stat is { icon: string; label: string } => stat !== null);

// Not every listing publishes a price. "Price on application" is the trade's
// term for exactly that, and it is a true statement about the record — unlike
// a number, which would have to be invented.
const priceLabel = project.price ?? "Price on application";
---

{
  variant === "card" ? (
    <article class:list={["group", className]}>
      <a
        href={href}
        class="luxury-shadow block overflow-hidden rounded-lg bg-surface"
      >
        <div class="relative h-80 overflow-hidden">
          {project.hero ? (
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
              style={`background-image: url('${project.hero.src}')`}
              role="img"
              aria-label={project.hero.alt}
            />
          ) : (
            /* No photography on this record. A typographic panel in the house
               palette, rather than another listing's photograph. */
            <div class="absolute inset-0 flex flex-col justify-end bg-primary p-8">
              <span class="font-label-md text-label-md tracking-widest text-secondary-fixed uppercase">
                {project.city}
              </span>
              <span class="font-headline-md text-headline-md mt-2 text-on-primary">
                {project.name}
              </span>
            </div>
          )}
          {project.badge && (
            <span class="font-label-md absolute top-4 right-4 rounded-full bg-primary px-3 py-1 text-xs tracking-wider text-secondary-fixed uppercase">
              {project.badge}
            </span>
          )}
        </div>

        <div class="p-8">
          <div class="mb-4 flex items-start justify-between gap-4">
            <span class="font-label-md text-label-md text-on-secondary-container">
              {project.city}
            </span>
            <span class="font-label-md text-label-md text-primary">
              {priceLabel}
            </span>
          </div>

          <h3 class="font-headline-sm text-headline-sm mb-4 text-primary transition-colors group-hover:text-on-secondary-container">
            {project.name}
          </h3>

          {stats.length > 0 && (
            <div class="font-label-md flex flex-wrap gap-6 border-t border-outline-variant pt-4 text-sm text-on-surface-variant">
              {stats.map((stat) => (
                <span class="flex items-center gap-2">
                  <Icon name={stat.icon} class="text-lg" />
                  {stat.label}
                </span>
              ))}
            </div>
          )}
        </div>
      </a>
    </article>
  ) : (
    <article class:list={["group", className]}>
      <a href={href} class="block">
        <div class="relative mb-6 aspect-[4/3] overflow-hidden">
          {project.hero ? (
            <img
              src={project.hero.src}
              alt={project.hero.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            <div class="flex h-full w-full items-end bg-primary p-6">
              <span class="font-headline-sm text-headline-sm text-on-primary">
                {project.name}
              </span>
            </div>
          )}
        </div>

        <div class="flex flex-col gap-2 px-4">
          <p class="font-label-md text-label-md text-secondary uppercase">
            {priceLabel}
          </p>
          <h2 class="font-headline-md text-headline-md text-primary transition-colors group-hover:text-secondary">
            {project.name}
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant">
            {project.city}
          </p>
          {stats.length > 0 && (
            <div class="font-label-md text-label-md mt-2 flex flex-wrap gap-8 text-outline">
              {stats.map((stat) => (
                <span class="flex items-center gap-1">
                  <Icon name={stat.icon} class="text-sm" />
                  {stat.label}
                </span>
              ))}
            </div>
          )}
        </div>
      </a>
    </article>
  )
}
