---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/react/ContactForm";
import { media } from "../data/media";
import { site } from "../data/site";
import { listAllProjects, summarise } from "../services";

// The telephone number and three office addresses here were invented, so they
// are gone: an invented phone number on a contact page is the one placeholder
// a visitor will actually try to use. What is left is the enquiry form, the
// email address, and the markets the portfolio genuinely covers.
const details = [
  {
    icon: "mail",
    label: "Email",
    value: "enquiries@latitude8estate.com",
    href: "mailto:enquiries@latitude8estate.com",
  },
];

const markets = summarise(await listAllProjects()).marketNames;

// What happens after the form, so nobody has to wonder.
const steps = [
  {
    title: "A reply from a principal",
    body: "Your enquiry goes to one of the principals, not a mailbox. We reply with a time for a call, in your time zone, and a note of what would help us prepare.",
  },
  {
    title: "A conversation, not a pitch",
    body: "We ask how the house will be used, by whom and for how much of the year, because that decides which stretch of coast is right before any listing does.",
  },
  {
    title: "Houses, seen properly",
    body: "A shortlist with the honest case for and against each one, walked live on video if you are abroad, and visited together when you are on the island.",
  },
  {
    title: "The purchase, managed",
    body: "Ownership structure, independent legal review, the contract and the transfer at the Land Office, handled end to end by the same person you first spoke to.",
  },
];
---

<BaseLayout
  title="Contact Us"
  description={`Speak with a ${site.legalName} principal about buying, selling or managing a villa, estate or condominium in Phuket or Koh Samui. Every enquiry is handled in confidence.`}
>
  <Hero
    image={media.contactHero}
    eyebrow="Contact Us"
    title="Start a conversation."
    lead="Tell us what you are looking for, or what you are considering selling. Every enquiry is handled in confidence by a principal."
    overlay="dark"
  />

  <main>
    <section
      class="mx-auto max-w-page px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
        {/* Details */}
        <div class="space-y-12 lg:col-span-5">
          <div class="space-y-6">
            {
              details.map((detail) => (
                <div class="flex items-start gap-4">
                  <Icon name={detail.icon} class="text-3xl text-secondary" />
                  <div>
                    <p class="font-label-md text-label-md mb-1 tracking-wider text-on-surface-variant uppercase">
                      {detail.label}
                    </p>
                    {detail.href ? (
                      <a
                        href={detail.href}
                        class="font-body-lg text-body-lg text-primary transition-colors hover:text-secondary"
                      >
                        {detail.value}
                      </a>
                    ) : (
                      <p class="font-body-lg text-body-lg text-primary">
                        {detail.value}
                      </p>
                    )}
                  </div>
                </div>
              ))
            }
          </div>

          {
            markets.length > 0 && (
              <div>
                <h2 class="font-headline-sm text-headline-sm mb-6 text-primary">
                  Where We Represent
                </h2>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 lg:grid-cols-1">
                  {markets.map((market) => (
                    <p class="font-body-md text-body-md rounded-xl border border-surface-container-high bg-surface-container-low p-6 text-on-surface-variant">
                      {market}
                    </p>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        {/* Form */}
        <div class="lg:col-span-7 space-y-12">
          <div
            class="rounded-xl border border-outline-variant/30 bg-surface-container-highest p-8 shadow-xl md:p-12"
          >
            <h2 class="font-headline-sm text-headline-sm mb-2 text-primary">
              Send an enquiry
            </h2>
            <p class="font-body-md mb-6 text-sm text-on-surface-variant">
              Leave your details and a specialist will contact you shortly.
            </p>
            <ContactForm client:visible submitLabel="Send Enquiry" />
          </div>

          <div>
            <h2 class="font-headline-sm text-headline-sm mb-8 text-primary">What happens next</h2>
            <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              {
                steps.map((step, index) => (
                  <li class="rounded-xl border border-surface-container-high bg-surface-container-low p-6">
                    <span class="font-label-md text-label-md mb-3 block tracking-widest text-secondary uppercase">
                      Step {index + 1}
                    </span>
                    <h3 class="font-headline-sm mb-2 text-lg text-primary">{step.title}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">{step.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
