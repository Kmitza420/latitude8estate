---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioView from "../../components/PortfolioView.astro";
import { getProperties } from "../../services";

const { projects, totalPages } = await getProperties(1);
---

<BaseLayout
  title="The Portfolio"
  description="A curated collection of the world's most prestigious residences."
>
  <PortfolioView projects={projects} currentPage={1} totalPages={totalPages} />
</BaseLayout>
