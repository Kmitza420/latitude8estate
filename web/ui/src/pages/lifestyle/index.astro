---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryTile from "../../components/CategoryTile.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import Newsletter from "../../components/Newsletter.astro";
import PostCard from "../../components/PostCard.astro";
import { media } from "../../data/media";
import { getFeaturedPost, listAllPosts, listCategories } from "../../services";

const [categories, posts, featuredPost] = await Promise.all([
  listCategories(),
  listAllPosts(),
  getFeaturedPost(),
]);

const tiles = categories.filter((category) => category.featured);
const latest = posts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 3);

const description = `The Latitude 8 Estate journal: ${posts.length} articles on architecture, interiors, the property market and life on the coast of Phuket and Koh Samui, written by people who build, survey and sell here.`;
---

<BaseLayout title="Lifestyle: Architecture, Interiors and the Phuket Market" description={description}>
  <Hero
    image={media.journalHero}
    eyebrow="The Journal"
    title="Lifestyle"
    lead="Architecture, interiors, the market and the rituals of living well on the coast of Phuket and Koh Samui, written by people who build, survey and sell here."
    overlay="tint"
  />

  <main
    class="mx-auto w-full max-w-page px-margin-mobile pb-section-gap md:px-margin-desktop"
  >
    {/* What the journal is for */}
    <section class="mt-section-gap grid grid-cols-1 gap-gutter lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="font-headline-lg text-headline-lg-mobile text-primary md:text-headline-lg">
          Written for people who own, or want to own, a house on this coast.
        </h2>
      </div>
      <div class="space-y-6 lg:col-span-7">
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          The journal exists because the questions our clients ask are rarely
          about square metres. They are about what board-formed concrete
          actually costs over ten years, why a deep roof overhang does more
          than any glass coating, how a foreign buyer holds land in Thailand,
          and what happens to an empty tropical house in a monsoon.
        </p>
        <p class="font-body-md text-body-md text-on-surface-variant">
          The writers are the people we work with: an editor who covers the
          architecture and the market of southern Thailand, and a former
          surveyor who covers construction quality, materials and long-term
          value. Articles are grouped by category below, and the market pieces
          sit beside the buying guide on the Projects page.
        </p>
      </div>
    </section>

    {/* Categories */}
    <section class="mt-section-gap">
      <h2 class="sr-only">Categories</h2>
      <div class="grid grid-cols-1 gap-gutter sm:grid-cols-2 lg:grid-cols-4">
        {
          tiles.map((category) => (
            <CategoryTile
              title={category.name}
              href={`/lifestyle/category/${category.slug}`}
              image={category.image}
              shape="square"
            />
          ))
        }
      </div>
    </section>

    {/* Featured — omitted entirely when the API has no published articles. */}
    {
      featuredPost && (
        <section class="mt-section-gap">
          <h2 class="sr-only">Featured</h2>
          <div class="grid grid-cols-1 items-center gap-gutter lg:grid-cols-12">
            <div class="luxury-shadow group relative h-[500px] overflow-hidden rounded-lg lg:col-span-7">
              {featuredPost.image ? (
                <img
                  src={featuredPost.image.src}
                  alt={featuredPost.image.alt}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div class="h-full w-full bg-primary" />
              )}
            </div>
            <div class="luxury-shadow relative z-10 rounded-lg bg-surface-container p-8 md:p-12 lg:col-span-5 lg:-ml-12">
              <span class="font-label-md text-label-md mb-4 block tracking-widest text-secondary uppercase">
                Featured
              </span>
              <h3 class="font-headline-lg text-headline-lg-mobile mb-6 text-primary md:text-headline-lg">
                {featuredPost.title}
              </h3>
              <p class="font-body-md text-body-md mb-8 text-on-surface-variant">
                {featuredPost.excerpt}
              </p>
              <a
                href={`/lifestyle/${featuredPost.slug}`}
                class="font-label-md text-label-md inline-flex items-center justify-center rounded-full bg-primary px-8 py-3 text-on-primary transition-colors duration-300 hover:bg-secondary hover:text-on-secondary"
              >
                Read Article
              </a>
            </div>
          </div>
        </section>
      )
    }

    {/* Latest */}
    <section class="mt-section-gap">
      <div
        class="mb-12 flex items-end justify-between border-b border-outline-variant/30 pb-4"
      >
        <h2 class="font-headline-md text-headline-md text-primary">
          Latest Narratives
        </h2>
        {
          tiles[0] && (
            <a
              href={`/lifestyle/category/${tiles[0].slug}`}
              class="font-label-md text-label-md flex items-center gap-1 text-secondary transition-colors hover:text-primary"
            >
              View All
              <Icon name="arrow_forward" class="text-[18px]" />
            </a>
          )
        }
      </div>

      <div class="grid grid-cols-1 gap-gutter md:grid-cols-3">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    {/* Newsletter */}
    <section class="mt-section-gap">
      <Newsletter
        heading="Curated Excellence, Delivered."
        body="Join our exclusive readership to receive a monthly digest of architectural marvels, market insights, and the art of fine living."
        layout="centered"
      />
    </section>
  </main>
</BaseLayout>
