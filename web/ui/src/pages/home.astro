---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTile from "../components/CategoryTile.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Newsletter from "../components/Newsletter.astro";
import PostCard from "../components/PostCard.astro";
import PropertyCard from "../components/PropertyCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import AreaCard from "../components/AreaCard.astro";
import Faq from "../components/Faq.astro";
import { areas } from "../data/areas";
import { media } from "../data/media";
import { collections } from "../data/collections";
import { homeFaq } from "../data/faqs";
import { faqSchema } from "../data/seo";
import { site } from "../data/site";
import {
  getFeaturedPost,
  getFeaturedProjects,
  listAllPosts,
  listAllProjects,
  summarise,
} from "../services";

const [featuredProjects, allProjects, posts, lifestyleLead] = await Promise.all([
  getFeaturedProjects(3),
  listAllProjects(),
  listAllPosts(),
  getFeaturedPost(),
]);

// The three articles beside the lead story, whatever they turn out to be —
// this used to name four specific slugs, which no longer exist once the
// articles come from the database.
const lifestyleRail = posts
  .filter((post) => post.slug !== lifestyleLead?.slug)
  .slice(0, 3);

// This band used to carry an invented client testimonial. Nothing in the
// database backs a quotation, so it reports the portfolio instead — every
// figure counted from the listings actually published.
const portfolio = summarise(allProjects);

const figures = [
  { value: String(portfolio.total), label: "Listings represented" },
  { value: String(portfolio.markets), label: portfolio.markets === 1 ? "Market" : "Markets" },
  { value: String(portfolio.completed), label: "Completed" },
  { value: String(portfolio.underConstruction), label: "Under construction" },
].filter((figure) => figure.value !== "0");
---

<BaseLayout title={site.tagline} description={site.description} jsonLd={faqSchema(homeFaq)}>
  {/* Hero copy sits over the image, anchored to its lower-left corner. */}
  <Hero
    image={media.homeHero}
    eyebrow="Luxury real estate in Phuket & Koh Samui"
    title="Architectural Masterpieces."
    lead="Villas, private estates and condominiums on the coasts of Phuket and Koh Samui, selected for how they are built and represented by one principal from first conversation to completion."
    overlay="scrim"
    animate
  />

  <main>
    {/* Categories, mirroring the top bar and drawer */}
    <section
      class="mx-auto max-w-page px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-5">
        {
          collections.map((collection) => (
            <CategoryTile
              title={collection.label}
              href={collection.href}
              image={collection.image}
            />
          ))
        }
      </div>
    </section>

    {/* What we do, in prose: the page's one substantial piece of copy. */}
    <section
      class="bg-surface-container-low px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div class="mx-auto grid max-w-page grid-cols-1 gap-gutter lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="Latitude 8 Estate"
            title="Luxury property in Phuket, chosen for how it is built"
          />
        </div>
        <div class="space-y-6 lg:col-span-7">
          <p class="font-body-lg text-body-lg text-on-surface-variant">
            Latitude 8 Estate represents a small number of villas, private
            estates and low-rise condominiums on the coasts of Phuket and Koh
            Samui. Every house on our books has been assessed for the things
            that decide what it is worth to own in this climate: its structure
            and materials, its title and ownership structure, its running costs,
            and the honest case against it.
          </p>
          <p class="font-body-md text-body-md text-on-surface-variant">
            We work with buyers who want a house on the Andaman coast and with
            owners who are ready to sell one. For a buyer that means a search
            across the stretches of coast that suit how the house will be used,
            from the established estates above Bang Tao to the protected
            shoreline at Nai Thon and the calm bays of the east coast, followed
            by a purchase managed through to the Land Office. For a seller it
            means preparing the house and its paperwork, presenting it to
            qualified buyers only, and handling the negotiation and transfer.
          </p>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Because most of our clients live abroad for part of the year, we
            also manage the houses we sell: the systems, the pool and the
            garden, the household staff, and a monthly report with photographs,
            so that a house holds its value in the months its owner is away.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="/projects"
              class="font-label-md text-label-md inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3 text-on-primary transition-colors hover:bg-secondary"
            >
              View the portfolio
              <Icon name="arrow_forward" />
            </a>
            <a
              href="/property-management"
              class="font-label-md text-label-md inline-flex items-center gap-2 rounded-full border border-primary px-8 py-3 text-primary transition-colors hover:bg-primary hover:text-on-primary"
            >
              Property management
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Featured estates */}
    <section
      class="bg-surface px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div class="mx-auto max-w-page">
        <SectionHeading
          eyebrow="Exclusive Portfolio"
          title="Featured Estates"
          class="mb-16"
        >
          <a
            href="/projects"
            class="font-label-md text-label-md hidden items-center gap-2 text-primary transition-all hover:gap-4 md:flex"
          >
            View the portfolio
            <Icon name="arrow_forward" />
          </a>
        </SectionHeading>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {
            featuredProjects.map((project, index) => (
              <PropertyCard
                project={project}
                class={index === 2 ? "hidden md:block" : undefined}
              />
            ))
          }
        </div>
      </div>
    </section>

    {/* Lifestyle bento */}
    <section
      class="mx-auto max-w-page px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <SectionHeading
        eyebrow="Lifestyle"
        title="Insights & Editorial"
        align="center"
        class="mb-16"
      />

      {
        lifestyleLead && (
          <div class="grid grid-cols-1 gap-8 lg:h-[600px] lg:grid-cols-12">
            <article class="luxury-shadow group relative h-[400px] overflow-hidden rounded-xl lg:col-span-8 lg:h-full">
              {lifestyleLead.image ? (
                <div
                  class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                  style={`background-image: url('${lifestyleLead.image.src}')`}
                  role="img"
                  aria-label={lifestyleLead.image.alt}
                />
              ) : (
                <div class="absolute inset-0 bg-primary" />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-primary via-primary/40 to-transparent opacity-90" />
              <div class="absolute bottom-0 left-0 w-full p-10 lg:w-3/4">
                <span class="font-label-md text-label-md mb-4 block tracking-widest text-secondary-fixed uppercase">
                  {lifestyleLead.category?.name}
                </span>
                <h3 class="font-headline-md text-headline-md mb-4 leading-tight text-on-primary">
                  {lifestyleLead.title}
                </h3>
                <p class="font-body-md text-body-md mb-6 hidden text-on-primary/80 md:block">
                  {lifestyleLead.excerpt}
                </p>
                <a
                  href={`/lifestyle/${lifestyleLead.slug}`}
                  class="font-label-md inline-flex items-center gap-2 text-secondary-fixed transition-all hover:gap-4"
                >
                  Read Story
                  <Icon name="arrow_forward" />
                </a>
              </div>
            </article>

            <div class="flex h-full flex-col gap-8 lg:col-span-4">
              {lifestyleRail.map((post, index) => (
                <>
                  {index > 0 && <div class="h-px w-full bg-outline-variant/30" />}
                  <PostCard post={post} variant="compact" />
                </>
              ))}
            </div>
          </div>
        )
      }
    </section>

    {/* The portfolio, in figures */}
    <section
      class="relative overflow-hidden bg-sand px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: radial-gradient(#06362D 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-page">
        <SectionHeading
          eyebrow="The Portfolio"
          title="What we currently represent"
          align="center"
          class="mb-16"
        />

        <dl class="grid grid-cols-2 gap-8 text-center md:grid-cols-4">
          {
            figures.map((figure) => (
              <div>
                <dt class="sr-only">{figure.label}</dt>
                <dd>
                  <span class="font-display-lg text-headline-lg block text-primary">
                    {figure.value}
                  </span>
                  <span class="font-label-md text-label-md mt-2 block tracking-wider text-primary/70 uppercase">
                    {figure.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>

        {
          portfolio.marketNames.length > 0 && (
            <p class="font-body-md text-body-md mt-12 text-center text-primary/70">
              {portfolio.marketNames.join(" · ")}
            </p>
          )
        }
      </div>
    </section>

    {/* Where the portfolio is */}
    <section
      class="bg-surface-container-low px-margin-mobile py-section-gap md:px-margin-desktop"
    >
      <div class="mx-auto max-w-page">
        <SectionHeading
          eyebrow="Where We Represent"
          title="Phuket and Koh Samui, coast by coast"
          lead="The island is forty-eight kilometres long and changes character every few of them. These are the stretches where our houses are, and what each one is for."
          align="center"
          class="mb-16"
        />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {areas.map((area) => <AreaCard area={area} />)}
        </div>
      </div>
    </section>

    {/* Questions */}
    <section class="mx-auto max-w-page px-margin-mobile py-section-gap md:px-margin-desktop">
      <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeading eyebrow="Questions" title="What clients ask first" />
          <p class="font-body-md text-body-md mt-6 text-on-surface-variant">
            The buying guide on the Projects page goes further into ownership
            structures, due diligence and costs.
          </p>
        </div>
        <div class="lg:col-span-8">
          <Faq items={homeFaq} />
        </div>
      </div>
    </section>

    {/* Newsletter */}
    <section class="bg-surface px-margin-mobile py-section-gap md:px-margin-desktop">
      <div class="mx-auto max-w-page">
        <Newsletter
          heading="Curated Excellence,<br />Delivered."
          body="Subscribe to our private list for exclusive off-market listings, architectural insights, and market intelligence."
          note="By subscribing, you agree to our Privacy Policy. We respect your discretion."
        />
      </div>
    </section>
  </main>
</BaseLayout>
