# Copy to .env.prod, replace every value, and chmod 600 .env.prod.
# These values are read by Docker Compose, not committed secrets.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
MINIO_ROOT_USER=l8e-replace-me
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
AUTH_JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
PUBLIC_SITE_ORIGIN=https://example.com
PUBLIC_API_ORIGIN=https://api.example.com
