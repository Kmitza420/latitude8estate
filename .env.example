# Copy to .env at the repository root. `core/settings.py` reads it from there,
# so `python -m scripts.seed` and `uvicorn web.api.main:app` both pick it up.
#
# Every name here must match a field on core.settings.Settings — anything else
# is ignored silently (extra="ignore"), which is an easy way to think you have
# configured something you have not.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — matches the `postgres` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=latitude8estate_db

# MinIO. MINIO_PUBLIC_BASE_URL is the base a *browser* uses; leave it empty to
# fall back to http://{MINIO_ENDPOINT}/{MINIO_PUBLIC_BUCKET}.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_BUCKET=latitude8estate-media
MINIO_PUBLIC_BASE_URL=http://localhost:9000/latitude8estate-media

# CORS — the Astro dev server and the docker-compose web_ui container.
# Never "*" in production: it is paired with allow_credentials, and it also
# feeds TrustedHostMiddleware.
CORS_ORIGINS=http://localhost:4321,http://localhost:3001
